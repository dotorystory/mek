# =============================================================================
# 통합 .gitignore 샘플
# 병합 출처: public/app_helloart_kr, public/api_helloart_kr, public/1446_kr
# 사용: 프로젝트 성격에 맞게 섹션을 골라 복사하거나, 불필요한 블록은 삭제하세요.
# =============================================================================

/img360/
/public/view/img360/*
/storage
/storage/*
/upload
/upload/*

# -----------------------------------------------------------------------------
# 로컬 비밀·환경 (1446_kr + api 공통)
# 템플릿만 커밋하는 경우 예: .config/common_info.sample
# -----------------------------------------------------------------------------
.config/common_info
/resources/config/common_info.php
.env
.env.*
!.env.example
.env.backup

# -----------------------------------------------------------------------------
# Laravel (api_helloart_kr)
# -----------------------------------------------------------------------------
/public/hot
/public/storage
/storage/*.key
Homestead.json
Homestead.yaml
docker-compose.override.yml
.phpunit.result.cache

# -----------------------------------------------------------------------------
# 그누보드(Gnuboard) 사이트 — 반드시 제외 권장
# -----------------------------------------------------------------------------
# data/     : 업로드·에디터 첨부·썸네일·캐시 등 용량·개인정보·환경 의존. 소스가 아님.
# dbconfig.php : DB 호스트·계정·비밀번호. 커밋 시 유출 위험 → dbconfig.php.sample 등만 저장소에 둠.
# (제외하지 않아도 “동작”은 하지만, 백업·이관은 rsync/배포 스크립트로 하고 Git에는 올리지 않는 것이 일반적입니다.)
data/
dbconfig.php

# -----------------------------------------------------------------------------
# PHP — Composer (api, 1446)
# -----------------------------------------------------------------------------
vendor/

# -----------------------------------------------------------------------------
# Python 가상환경·캐시 (1446_kr)
# -----------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
.virtualenv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# -----------------------------------------------------------------------------
# Node / 프론트 빌드 (app + api + 1446 통합)
# -----------------------------------------------------------------------------
node_modules/
jspm_packages/
bower_components/
typings/
.npm/
.yarn/
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn-integrity
.parcel-cache/
.cache
.next/
.nuxt/
.svelte-kit/
out/
dist/
.turbo/
.vercel/
*.tsbuildinfo

# 레거시·도구 (app_helloart_kr Node 템플릿)
.grunt
lib-cov
.lock-wscript
build/Release
.nyc_output
coverage/
.eslintcache
.node_repl_history
*.tgz
.serverless
.vuepress/dist
sw.*

# -----------------------------------------------------------------------------
# 로그·런타임·임시 (1446 + app)
# -----------------------------------------------------------------------------
logs/
log/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/
*.tmp
*.temp
cache/
*.pid
*.seed
*.pid.lock
pids

# -----------------------------------------------------------------------------
